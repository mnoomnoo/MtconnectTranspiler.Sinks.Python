[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "pymtconnect"
version = "1.0.0"
description = "Python model classes generated from the MTConnect SysML specification"
readme = "README.md"
license = { text = "Apache-2.0" }
requires-python = ">=3.10"
dependencies = [
    "requests>=2.33"
]

[tool.setuptools.packages.find]
where = ["."]
exclude = ["__pycache__*", "example*"]

[project.urls]
Homepage = "https://github.com/mnoomnoo/MtconnectTranspiler.Sinks.Python"
Issues = "https://github.com/mnoomnoo/MtconnectTranspiler.Sinks.Python/issues"

[project.optional-dependencies]
dev = ["pytest>=8.0"]



